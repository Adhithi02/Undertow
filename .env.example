# Neon Postgres connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Cookie signing secret (HMAC) — either name works; set at least one in production
AUTH_SECRET="change-me-to-a-random-string-in-production"
COOKIE_SECRET="change-me-to-a-random-string-in-production"

# Optional Finnhub live price lookup and supplementary analyst recommendation context
FINNHUB_API_KEY="your-finnhub-api-key"

# SMTP delivery for "Email me this briefing"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-smtp-app-password"
